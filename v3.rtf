<script>\
  // ---------- CONFIG ----------\
  var AGENCY_WHATSAPP_NUMBER = "994000000000"; // TODO: real number, format 994XXXXXXXXX\
\
  // ---------- HEADER SCROLL STATE ----------\
  var header = document.getElementById('siteHeader');\
  function onScroll()\{\
    if(window.scrollY > 30)\{ header.classList.add('scrolled'); \}\
    else\{ header.classList.remove('scrolled'); \}\
  \}\
  window.addEventListener('scroll', onScroll);\
  onScroll();\
\
  // ---------- MOBILE MENU ----------\
  var burger = document.getElementById('burgerBtn');\
  var mobileMenu = document.getElementById('mobileMenu');\
  burger.addEventListener('click', function()\{\
    burger.classList.toggle('open');\
    mobileMenu.classList.toggle('open');\
  \});\
  document.querySelectorAll('.mobile-menu a').forEach(function(a)\{\
    a.addEventListener('click', function()\{\
      burger.classList.remove('open');\
      mobileMenu.classList.remove('open');\
    \});\
  \});\
\
  // ---------- SMOOTH SCROLL ----------\
  document.querySelectorAll('a[href^="#"]').forEach(function(link)\{\
    link.addEventListener('click', function(e)\{\
      var targetId = this.getAttribute('href');\
      if(targetId.length > 1)\{\
        var target = document.querySelector(targetId);\
        if(target)\{\
          e.preventDefault();\
          var headerOffset = 118;\
          var top = target.getBoundingClientRect().top + window.pageYOffset - headerOffset;\
          window.scrollTo(\{ top: top, behavior: 'smooth' \});\
        \}\
      \}\
    \});\
  \});\
\
  // ---------- SCROLL REVEAL ----------\
  var revealEls = document.querySelectorAll('.reveal');\
  var io = new IntersectionObserver(function(entries)\{\
    entries.forEach(function(entry)\{\
      if(entry.isIntersecting)\{\
        entry.target.classList.add('in');\
        io.unobserve(entry.target);\
      \}\
    \});\
  \}, \{ threshold: 0.15 \});\
  revealEls.forEach(function(el)\{ io.observe(el); \});\
\
  // ---------- PRE-FILL VACANCY FROM JOB CARDS ----------\
  document.querySelectorAll('.btn-apply').forEach(function(btn)\{\
    btn.addEventListener('click', function()\{\
      var vac = this.getAttribute('data-vacancy');\
      var select = document.getElementById('vacancy');\
      if(vac && select)\{\
        var optionExists = Array.from(select.options).some(function(o)\{ return o.value === vac; \});\
        if(optionExists)\{ select.value = vac; \}\
      \}\
    \});\
  \});\
\
  // ---------- FORM VALIDATION + WHATSAPP SUBMIT ----------\
  var form = document.getElementById('applyForm');\
  var modal = document.getElementById('successModal');\
  var whatsappLink = document.getElementById('whatsappLink');\
  var modalCloseBtn = document.getElementById('modalCloseBtn');\
\
  function setError(rowId, show)\{\
    var row = document.getElementById(rowId);\
    row.classList.toggle('invalid', show);\
    var err = row.querySelector('.form-error');\
    if(err)\{ err.classList.toggle('show', show); \}\
  \}\
\
  form.addEventListener('submit', function(e)\{\
    e.preventDefault();\
\
    var name = document.getElementById('fullName').value.trim();\
    var phone = document.getElementById('phone').value.trim();\
    var vacancy = document.getElementById('vacancy').value;\
    var note = document.getElementById('note').value.trim();\
\
    var phoneDigits = phone.replace(/[^0-9+]/g, '');\
    var nameValid = name.length >= 3;\
    var phoneValid = phoneDigits.replace(/\\D/g,'').length >= 9;\
    var vacancyValid = vacancy !== "";\
\
    setError('row-name', !nameValid);\
    setError('row-phone', !phoneValid);\
    setError('row-vacancy', !vacancyValid);\
\
    if(!nameValid || !phoneValid || !vacancyValid)\{ return; \}\
\
    var message = "Salam, Euro Career! M\uc0\u601 n vakansiyaya m\'fcraci\u601 t etm\u601 k ist\u601 yir\u601 m.%0A%0A" +\
      "
\f1 \uc0\u55357 \u56420 
\f0  Ad Soyad: " + encodeURIComponent(name) + "%0A" +\
      "
\f1 \uc0\u55357 \u56542 
\f0  Telefon: " + encodeURIComponent(phone) + "%0A" +\
      "
\f1 \uc0\u55357 \u56987 
\f0  Vakansiya: " + encodeURIComponent(vacancy) +\
      (note ? ("%0A
\f1 \uc0\u55357 \u56541 
\f0  Qeyd: " + encodeURIComponent(note)) : "");\
\
    var waUrl = "https://wa.me/" + AGENCY_WHATSAPP_NUMBER + "?text=" + message;\
    whatsappLink.setAttribute('href', waUrl);\
\
    modal.classList.add('open');\
    form.reset();\
  \});\
\
  modalCloseBtn.addEventListener('click', function()\{\
    modal.classList.remove('open');\
  \});\
  modal.addEventListener('click', function(e)\{\
    if(e.target === modal)\{ modal.classList.remove('open'); \}\
  \});\
  whatsappLink.addEventListener('click', function()\{\
    setTimeout(function()\{ modal.classList.remove('open'); \}, 400);\
  \});\
</script>\
\
